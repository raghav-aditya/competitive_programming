PriceCalculationService
{
	private Constant PRICE_FACTOR = 32.000 ;

	public Ticket calcualte( Ticket ticket )
	{
		double hour = Math.abs( ticket.inTime - ticket.outTime  );
		hour = Math.max( 1.000 , Math.ciel(hour) )

		ticket.price = PRICE_FACTOR*hour ;

		return ticket ;
	}
}

